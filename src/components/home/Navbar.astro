---
const links = [
  { href: '#about', label: 'About' },
  { href: '#logbook', label: 'Logbook' },
  { href: '#work', label: 'Work' },
  { href: '#certificates', label: 'Certificates' },
];
---
<nav style="position: sticky; top: 16px; z-index: 20; display: flex; justify-content: center; padding: 16px 16px 0">
<div style="display: flex; align-items: center; gap: 8px; background: var(--glass); backdrop-filter: blur(12px); border: 1px solid var(--line); border-radius: 999px; padding: 6px 6px 6px 18px">
<a href="#top" style="font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 18px; color: var(--ink); text-decoration: none; margin-right: 8px">Shaa<span style="color: var(--accent)">.</span></a>
<div class="navlinks" style="display: flex; gap: 2px">
{links.map((l) => <a class="navlink" href={l.href}>{l.label}</a>)}
</div>
<a href="#contact" style="text-decoration: none; background: var(--inv); color: var(--onInv); border-radius: 999px; padding: 10px 18px; font-size: 14px; font-weight: 600">Let's chat</a>
</div>
</nav>
