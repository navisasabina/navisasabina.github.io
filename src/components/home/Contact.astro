---
import ChatBot from './ChatBot.astro';
import { linkedinPath, githubPath } from './Icons';
import { site } from '../../data/site';
const row = 'display: flex; align-items: center; gap: 12px; min-height: 44px; color: var(--ink); text-decoration: none';
const tile = (bg: string, extra = '') => `width: 36px; height: 36px; flex: none; border-radius: 12px; background: ${bg}; display: flex; align-items: center; justify-content: center${extra}`;
---
<section id="contact" class="wrap" style="padding-top: 96px">
<div class="contact">
<div style="padding: 8px 0">
<p style="margin: 0 0 8px; font-family: 'Instrument Serif', serif; font-style: italic; font-size: 26px; color: var(--accent)">Say hello</p>
<h2 style="margin: 0; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: clamp(40px, 6vw, 72px); letter-spacing: -0.04em; line-height: 1">Let's work together.</h2>
<p style="margin: 24px 0 0; font-size: 17px; line-height: 1.65; color: var(--muted); max-width: 460px">Hiring an intern for 2027, or just want to say hi? Pick whatever's easiest for you.</p>
<ul style="list-style: none; margin: 28px 0 0; padding: 0; display: grid; gap: 4px; font-size: 15px">
<li><a href={`mailto:${site.email}`} style={row}><span style={tile('var(--accentSoft)')}><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg></span>{site.email}</a></li>
<li><a href={`https://wa.me/${site.whatsapp}?text=Hi%20Sasha!%20I%20saw%20your%20portfolio.`} style={row}><span style={tile('var(--mint)')}><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--mintInk)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 1-13.5 7.8L3 21l1.2-4.5A9 9 0 1 1 21 12z"></path></svg></span>{site.whatsappDisplay}</a></li>
<li><a href={site.linkedin} style={row}><span style={tile('var(--sky)', '; color: var(--skyInk)')}><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d={linkedinPath}></path></svg></span>linkedin.com/in/navisa-sabina</a></li>
<li><a href={site.github} style={row}><span style={tile('var(--lav)', '; color: var(--lavInk)')}><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d={githubPath}></path></svg></span>github.com/navisasabina</a></li>
<li style="display: flex; align-items: center; gap: 12px; min-height: 44px; color: var(--ink)"><span style={tile('var(--peach)')}><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--peachInk)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z"></path><circle cx="12" cy="9" r="2.5"></circle></svg></span>{site.location}</li>
</ul>
<p class="note hide-sm" aria-hidden="true" style="margin: 28px 0 0; font-size: 26px; transform: rotate(-2deg)">or ask my little bot →</p>
</div>

<ChatBot />
</div>
</section>
