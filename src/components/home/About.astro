---
import Toolbox from './Toolbox.astro';
import { site } from '../../data/site';
const city = "font-family: 'Instrument Serif', serif; font-style: italic; color: var(--accent); font-size: 1.12em";
const pill = 'color: var(--onInv); font-size: 14px; border: 1px solid currentColor; border-radius: 999px; padding: 6px 12px; text-decoration: none; opacity: .85';
---
<section id="about" class="wrap" style="padding-bottom: 96px">
<div class="bento">
<div class="b-photo" style="background: var(--pink); border-radius: 28px; min-height: 420px; position: relative; overflow: hidden">
<div aria-hidden="true" style="position: absolute; left: 50%; top: 14%; width: 78%; aspect-ratio: 1 / 1; transform: translateX(-50%); border-radius: 999px; background: var(--pink2)"></div>
<img src="assets/profile.webp" alt="Portrait of Navisa Ersa Sabina" style="position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 86%; object-fit: contain; object-position: 50% 100%">
<p class="note" aria-hidden="true" style="position: absolute; left: 20px; top: 10px; margin: 0; font-size: 26px; transform: rotate(-8deg)">hi, that's me ↘</p>
<div class="badge" aria-hidden="true" style="position: absolute; right: 16px; bottom: 16px; width: 92px; height: 92px; border-radius: 999px; background: var(--bg); display: flex; align-items: center; justify-content: center"><svg width="92" height="92" viewBox="0 0 100 100"><defs><path id="ring" d="M50,50 m-36,0 a36,36 0 1,1 72,0 a36,36 0 1,1 -72,0"></path></defs><text font-family="DM Sans, sans-serif" font-size="11" font-weight="600" letter-spacing="2.4" fill="var(--accent)"><textPath href="#ring">OPEN TO WORK ✿ OPEN TO WORK ✿</textPath></text></svg></div>
</div>
<div class="b-bio" style="background: var(--surface); border-radius: 28px; padding: 36px; border: 1px solid var(--line)">
<p style="margin: 0 0 12px; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--soft); font-weight: 600">About me</p>
<p style="margin: 0; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 500; font-size: clamp(22px, 2.4vw, 30px); line-height: 1.3; letter-spacing: -0.01em">IT student at President University, splitting my time between <span style={city}>Batam</span> and <span style={city}>Cikarang</span>.</p>
<p style="margin: 18px 0 0; font-size: 16px; line-height: 1.7; color: var(--muted)">Right now I'm interning in the IT unit of RS Awal Bros Botania: fixing hardware and network issues by day, and designing ABiTA and AB-Portal from scratch. Before that I spent a semester in Malaysia forecasting demand from a million e-commerce transactions, and two years running merch sales for my student association.</p>
</div>
<div class="b-stat" style="background: var(--mint); border-radius: 28px; padding: 24px; display: flex; flex-direction: column; justify-content: space-between; min-height: 170px">
<span style="font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 52px; letter-spacing: -0.03em; line-height: 1">3.64</span>
<span style="font-size: 14px; color: var(--mintInk); font-weight: 500">GPA, on a 75% scholarship</span>
</div>
<div class="b-stat" style="background: var(--peach); border-radius: 28px; padding: 24px; display: flex; flex-direction: column; justify-content: space-between; min-height: 170px">
<span style="font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 52px; letter-spacing: -0.03em; line-height: 1">9</span>
<span style="font-size: 14px; color: var(--peachInk); font-weight: 500">projects, 2 of them for a real hospital</span>
</div>
<div class="b-uni" style="background: var(--inv); color: var(--onInv); border-radius: 28px; padding: 24px; display: flex; flex-direction: column; justify-content: space-between; gap: 16px; min-height: 170px">
<span style="font-family: 'Instrument Serif', serif; font-style: italic; font-size: 26px; line-height: 1.2">Looking for a 3–4 month internship from January 2027</span>
<div style="display: flex; gap: 8px; flex-wrap: wrap">
<a href={site.linkedin} style={pill}>LinkedIn</a>
<a href={site.github} style={pill}>GitHub</a>
<a href={`mailto:${site.email}`} style={pill}>Email</a>
</div>
</div>
</div>

<Toolbox />
</section>
