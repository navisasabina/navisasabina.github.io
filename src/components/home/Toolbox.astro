---
import { toolbox } from '../../data/skills';

const icons: Record<string, string> = {
  monitor: '<rect x="2" y="4" width="20" height="13" rx="2"></rect><path d="M8 21h8"></path><path d="M12 17v4"></path>',
  chart: '<path d="M3 3v18h18"></path><path d="M7 15l4-4 3 3 5-6"></path>',
  layout: '<rect x="3" y="3" width="18" height="18" rx="3"></rect><path d="M3 9h18"></path><path d="M9 21V9"></path>',
  code: '<path d="M8 6l-6 6 6 6"></path><path d="M16 6l6 6-6 6"></path>',
};
---
<h2 style="margin: 72px 0 24px; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: clamp(32px, 4vw, 48px); letter-spacing: -0.03em">My toolbox</h2>
<div class="exp">
{toolbox.map((t) => (
<div style="background: var(--surface); border: 1px solid var(--line); border-radius: 24px; padding: 24px">
<div style={`width: 40px; height: 40px; border-radius: 12px; background: ${t.bg}; display: flex; align-items: center; justify-content: center`}><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke={t.ink} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[t.icon]}></svg></div>
<h3 style="margin: 18px 0 10px; font-family: 'Bricolage Grotesque', sans-serif; font-size: 20px; font-weight: 700">{t.title}</h3>
<p style="margin: 0; font-size: 14px; line-height: 1.7; color: var(--muted)">{t.tools}</p>
</div>
))}
</div>
