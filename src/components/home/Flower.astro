---
// The little five-petal flower used as decoration.
interface Props {
  petal: string;
  center: string;
  size: number;
  class?: string;
  style?: string;
}
const { petal, center, size, class: className, style } = Astro.props;
---
<svg class={className} aria-hidden="true" width={size} height={size} viewBox="0 0 40 40" style={style}><g fill={petal}><circle cx="20" cy="9" r="8"></circle><circle cx="30.5" cy="16.5" r="8"></circle><circle cx="26.5" cy="29" r="8"></circle><circle cx="13.5" cy="29" r="8"></circle><circle cx="9.5" cy="16.5" r="8"></circle></g><circle cx="20" cy="20" r="5" fill={center}></circle></svg>
