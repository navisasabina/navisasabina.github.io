---
import { certificates, certificateFilters } from '../../data/certificates';
// Filtering happens in src/scripts/home.js using the data-k / data-t attributes.
const count = (key: string) => (key === 'all' ? certificates.length : certificates.filter((c) => c.type === key).length);
---
<section id="certificates" style="background: var(--surface2); padding: 96px 0">
<div class="wrap">
<div style="display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: 28px">
<div>
<p style="margin: 0 0 8px; font-family: 'Instrument Serif', serif; font-style: italic; font-size: 26px; color: var(--accent)">Always learning</p>
<h2 style="margin: 0; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: clamp(40px, 6vw, 72px); letter-spacing: -0.04em; line-height: 1">Certificates.</h2>
</div>
<p class="note hide-sm" aria-hidden="true" style="margin: 0 0 6px; font-size: 24px; transform: rotate(-3deg)">click one to zoom in ↓</p>
</div>
<div role="group" aria-label="Filter certificates" style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px">
{certificateFilters.map((f) => (
<button type="button" class="fchip" aria-pressed={f.key === 'all' ? 'true' : 'false'} data-k={f.key} style="background: var(--surface); color: var(--ink); border: 1px solid var(--line2); border-radius: 999px; min-height: 44px; padding: 0 16px; font: inherit; font-size: 14px; font-weight: 600; cursor: pointer">{f.label} <span style="opacity: .6">{count(f.key)}</span></button>
))}
</div>
<div class="certs">
{certificates.map((c) => (
<figure class="cert" data-t={c.type} style="margin: 0; background: var(--surface); border-radius: 20px; padding: 12px; border: 1px solid var(--line)">
<div style="border-radius: 12px; overflow: hidden; aspect-ratio: 4 / 3; background: var(--bg)">
<img src={c.image} alt={`${c.title} certificate`} style="width: 100%; height: 100%; object-fit: cover; display: block">
</div>
<figcaption style="padding: 14px 6px 6px">
<p style="margin: 0 0 4px; font-family: ui-monospace, monospace; font-size: 12px; color: var(--soft)">{c.issuer} · {c.year}</p>
<p style="margin: 0; font-size: 15px; font-weight: 600; line-height: 1.4">{c.title}</p>
</figcaption>
</figure>
))}
</div>
</div>
</section>
