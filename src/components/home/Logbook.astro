---
import { logbook } from '../../data/logbook';
const body = 'font-size: 15px; line-height: 1.7; color: var(--muted)';
---
<section id="logbook" class="wrap" style="padding-bottom: 96px">
<div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 16px; margin-bottom: 36px">
<div>
<p style="margin: 0 0 8px; font-family: 'Instrument Serif', serif; font-style: italic; font-size: 26px; color: var(--accent)">Where I've been</p>
<h2 style="margin: 0; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: clamp(40px, 6vw, 72px); letter-spacing: -0.04em; line-height: 1">Logbook.</h2>
</div>
<p class="note hide-sm" aria-hidden="true" style="margin: 0 0 6px; font-size: 26px; transform: rotate(-3deg)">newest on top ↓</p>
</div>
<div style="border-top: 2px solid var(--ink)">
{logbook.map((e) => (
<div class="log" style="padding: 28px 0; border-bottom: 1px solid var(--line2)">
<div><p style="margin: 0; font-family: ui-monospace, monospace; font-size: 13px; color: var(--soft)">{e.dates}</p>{e.current && <p style="margin: 8px 0 0; display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; color: #2F7D55"><span class="live" aria-hidden="true"></span>now</p>}</div>
<div>
<h3 style="margin: 0; font-family: 'Bricolage Grotesque', sans-serif; font-size: 24px; letter-spacing: -0.02em">{e.role} <span style="font-weight: 500; color: var(--muted)">· {e.place}</span></h3>
{e.points && <ul style={`margin: 12px 0 0; padding-left: 18px; ${body}`}>{e.points.map((p) => <li>{p}</li>)}</ul>}
{e.text && <p style={`margin: 12px 0 0; ${body}`}>{e.text}</p>}
</div>
</div>
))}
</div>
</section>
