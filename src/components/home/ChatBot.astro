---
import BotIcon from './BotIcon.astro';
// Replies live in src/scripts/home.js.
const options = [
  { key: 'email', label: 'Email Sasha' },
  { key: 'wa', label: 'Chat on WhatsApp' },
  { key: 'cv', label: 'See her CV' },
  { key: 'about', label: 'Who is Sasha?' },
];
---
<div role="region" aria-label="Sasha's Bot chat" style="background: var(--surface); border-radius: 32px; border: 1px solid var(--line); box-shadow: 0 30px 60px -40px var(--shadow); overflow: hidden; display: flex; flex-direction: column">
<div style="display: flex; align-items: center; gap: 12px; padding: 18px 22px; background: var(--inv); color: var(--onInv)">
<div style="width: 40px; height: 40px; border-radius: 999px; background: #E3B7BC; display: flex; align-items: center; justify-content: center">
<BotIcon size={22} />
</div>
<div style="flex: 1">
<p style="margin: 0; font-weight: 600; font-size: 16px">Sasha's Bot</p>
<p style="margin: 2px 0 0; font-size: 12px; opacity: .75">Not an AI. Just a very polite helper.</p>
</div>
<button type="button" id="chatReset" aria-label="Restart chat" style="background: transparent; border: 1px solid currentColor; color: var(--onInv); border-radius: 999px; min-height: 44px; padding: 0 14px; font: inherit; font-size: 13px; cursor: pointer; opacity: .85">Restart</button>
</div>
<div id="chatBox" aria-live="polite" style="flex: 1; min-height: 340px; max-height: 420px; overflow-y: auto; padding: 22px; display: flex; flex-direction: column; gap: 12px; background: var(--bg)">
<div class="bubble" style="align-self: flex-start; max-width: 85%; display: flex; flex-direction: column; gap: 8px">
<div style="background: var(--surface); border: 1px solid var(--line); border-radius: 18px 18px 18px 6px; padding: 12px 16px; font-size: 15px; line-height: 1.5">Hi! I'm Sasha's little helper. What would you like to do?</div>
</div>
</div>
<div id="chatOptions" style="padding: 16px 18px 20px; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: 8px">
{options.map((o) => (
<button type="button" class="chip" data-k={o.key} style="background: var(--accentSoft); color: var(--accent); border: 1px solid var(--line2); border-radius: 999px; min-height: 44px; padding: 0 16px; font: inherit; font-size: 14px; font-weight: 600; cursor: pointer">{o.label}</button>
))}
</div>
</div>
