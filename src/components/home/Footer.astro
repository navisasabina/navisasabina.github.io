---
import { site } from '../../data/site';
---
<footer class="wrap" style="margin-top: 96px; padding-top: 32px; border-top: 1px solid var(--line2); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; font-size: 14px; color: var(--soft)">
<span>© 2026 {site.name} · <a href={site.linkedin} style="color: var(--soft)">LinkedIn</a> · <a href={site.github} style="color: var(--soft)">GitHub</a> · <a href={site.oldPortfolio} style="color: var(--soft)">Previous portfolio</a></span>
<span class="note" style="font-size: 22px">thanks for scrolling all the way down ✿</span>
</footer>
