---
import { projects, moreProjects } from '../../data/projects';
---
<section id="work" class="wrap" style="padding-bottom: 96px">
<div style="text-align: center; margin-bottom: 48px">
<p style="margin: 0 0 8px; font-family: 'Instrument Serif', serif; font-style: italic; font-size: 26px; color: var(--accent)">Selected work</p>
<h2 style="margin: 0; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: clamp(40px, 6vw, 72px); letter-spacing: -0.04em; line-height: 1">Things I've built.</h2>
</div>
<div class="work">
{projects.map((p) => {
  const bg = `var(--${p.color})`;
  // The pink card uses the main accent colour as its ink.
  const ink = p.color === 'pink' ? 'var(--accent)' : `var(--${p.color}Ink)`;
  return (
<a class:list={['card-link', { wide: p.wide }]} href={p.page} style={`background: ${bg}; border-radius: 36px; padding: 32px; overflow: hidden; position: relative`}>
<div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 16px">
<div>
<p style={`margin: 0 0 6px; font-family: ui-monospace, monospace; font-size: 13px; color: ${ink}`}>#{p.num} · {p.tag}</p>
<h3 style="margin: 0; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: clamp(28px, 3vw, 38px); letter-spacing: -0.03em; line-height: 1.05; color: var(--ink)">{p.title}</h3>
</div>
<span class="arrow" aria-hidden="true" style="flex: none; width: 44px; height: 44px; border-radius: 999px; background: var(--surface); display: flex; align-items: center; justify-content: center; font-size: 20px; color: var(--ink)">→</span>
</div>
<p style="margin: 14px 0 18px; font-size: 15px; line-height: 1.6; color: var(--ink); opacity: .85; max-width: 520px">{p.summary}</p>
<span class="stamp" style={`display: inline-block; margin-bottom: 18px; padding: 4px 10px; border: 2px solid ${ink}; border-radius: 8px; font-family: ui-monospace, monospace; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: ${ink}`}>{p.status}</span>
<div class="cover" style={`background: #FFFFFF; border-radius: 18px; aspect-ratio: ${p.aspect}; overflow: hidden; display: flex; align-items: center; justify-content: center`}>
<img src={p.image} alt={`${p.title} preview`} style={`width: 100%; height: 100%; object-fit: ${p.fit ?? 'cover'}; display: block`}>
</div>
{p.note && <p class="note hide-sm" aria-hidden="true" style={`position: absolute; right: 90px; top: 30px; margin: 0; font-size: 24px; transform: rotate(4deg); color: ${ink}`}>{p.note}</p>}
</a>
  );
})}
</div>

<h3 style="margin: 64px 0 20px; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 700; font-size: 24px; letter-spacing: -0.02em">More projects</h3>
<div class="more">
{moreProjects.map((m) => (
<a class="card-link" href={m.href} style="background: var(--surface); border: 1px solid var(--line); border-radius: 24px; padding: 12px; display: flex; flex-direction: column">
<div class="cover" style={`border-radius: 16px; overflow: hidden; aspect-ratio: 16 / 10; background: ${m.coverBg}`}><img src={m.image} alt={m.alt} style={`width: 100%; height: 100%; object-fit: ${m.fit};${m.position ? ` object-position: ${m.position};` : ''} display: block`}></div>
<div style="padding: 14px 10px 10px">
<p style="margin: 0 0 6px; font-family: ui-monospace, monospace; font-size: 12px; color: var(--soft)">#{m.num} · {m.tag}</p>
<h4 style="margin: 0 0 6px; font-family: 'Bricolage Grotesque', sans-serif; font-size: 19px; font-weight: 700">{m.title} <span class="arrow" aria-hidden="true">↗</span></h4>
<p style="margin: 0; font-size: 14px; line-height: 1.6; color: var(--muted)">{m.summary}</p>
</div>
</a>
))}
</div>
</section>
